{
  "name": "skillbridge-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env \"\"",
    "deploy:alpha": "wrangler deploy --env alpha",
    "deploy:production": "wrangler deploy --env \"\"",
    "cf:typegen": "wrangler types --env-interface CloudflareBindings",
    "check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "tsx scripts/migrate.ts",
    "db:migrate:remote": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.21",
    "jose": "^6.2.18",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.14",
    "wrangler": "^4.168.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261123.1": true
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
